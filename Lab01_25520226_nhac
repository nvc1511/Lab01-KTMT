	.data
a: .word 64,64,65,67,67,65,64,62,60,60,62,64,64,62,62 #luu cao do
b: .word 2,2,2,2,2,2,2,2,2,2,2,2,3,1,4 #luu do dai
c: .word 15 #so not
str1: .asciiz "Tong du kien (ms): "
str2: .asciiz "Thoi gian do duoc (ms): "
str3: .asciiz "\n"
str4: .asciiz " "
	.text
main:
	li $v0, 30
	syscall
	add $s0, $zero, $a0 #thoi gian dau
	la $s1, a #luu dia chi mang a vao s1
	la $s2, b #luu dia chi mang b vao s2
	lw $t0, c #luu so not vao mang t0
	li $t1, 0 # i = 0
	li $s5, 0 # luu tong thoi gian du kien
Loop:
	slt $t2, $t1, $t0
	beq $t2, $zero, end
	sll $t3, $t1, 2
	add $t4, $t3, $s1 #dia chi a[i]
	add $t5, $t3, $s2 #dia chi b[i]
	lw $s3, 0($t4) #luu gia tri a[i]
	lw $s4, 0($t5) #luu gia tri b[i]
	li $v0, 1
	add $a0, $zero, $s3
	syscall
	li $v0, 4
	la $a0, str4
	syscall
	li $v0, 1
	add $a0, $zero, $s4
	syscall
	li $v0, 4
	la $a0, str3
	syscall
	li $v0, 31
	add $a0, $zero, $s3
	addi $a0, $a0, 6
	add $a1, $zero, $s4
	mul $a1, $a1, 170
	add $s5, $s5, $a1 #cong vao tong thoi gian du kien
	addi $a2, $zero, 40
	li $a3, 100
	syscall
	li $v0, 32
	add $a0, $zero, $a1
	syscall
	addi $t1, $t1, 1
	j Loop
end:
	li $v0, 30
	syscall
	sub $s6, $a0, $s0 #thoi gian do duoc
	li $v0, 4
	la $a0, str1
	syscall
	li $v0, 1
	add $a0, $zero, $s5
	syscall
	li $v0, 4
	la $a0, str3
	syscall
	li $v0,4
	la $a0, str2
	syscall
	li $v0, 1
	add $a0, $zero, $s6 
	syscall

	.data
a: .word 0, 50, 100, 200, 300, 400, 9999 
b: .word 1720, 1780, 2070, 2620, 2970, 3120
str1: .asciiz "Nhap so kwh(0..9999): "
str2: .asciiz "Gia tri khong hop le, nhap lai.\n"
str3: .asciiz "Tien dien: "
	.text
main:
	li $v0, 4
	la $a0, str1
	syscall
	li $v0, 5 #nhap so dien da tieu thu
	syscall
	add $s3, $zero, $v0 #luu x trong s3
	sltiu $t0, $s3, 10000   #kiem tra dieu kien
	beq   $t0, $zero, invalid
	la $s0, a #dia chi mang a luu trong s0
	la $s1, b #dia chi mang b luu trong s1
	addi $s2, $zero, 0 #khoi tao tong = 0
	li $t3, 0 #i = 0
	li $t1, 6
Loop:
	slt $t2, $t3, $t1 # dieu kien lap
	beq $t2, $zero, end
	sll $t4, $t3, 2
	add $t4, $t4, $s0 #luu dia chi a[i]
	lw $t5, 0($t4) #luu gia tri a[i]
	ble $s3, $t5, end
	addi $t8, $t3, 1
	sll $t8, $t8, 2
	add $t8, $t8, $s0 #luu dia chi a[i+1]
	lw $s4, 0($t8) # luu gia tri a[i+1]
	slt $t2, $s3, $s4 #so sanh de lay gia tri top
	beq $t2, $zero, then
	bne $t2, $zero, else
then:
	add $s5, $zero, $s4 #s5 luu bien top
	j loop2
else:
	add $s5, $zero, $s3
	j loop2
loop2:
	sub $s6, $s5, $t5 #s6 luu so_kwh
	sll $t7, $t3, 2
	add $t7, $t7, $s1 #luu dia chi b[i]
	lw $s7, 0($t7) #luu gia tri b[i]
	mul $t7, $s6, $s7
	addu $s2, $s2, $t7
	addi $t3, $t3, 1
	j Loop
invalid: 
	li $v0,4
	la $a0, str2
	syscall
	j main
end:
	li $v0, 4
	la $a0, str3
	syscall
	li $v0, 1
	add $a0, $zero, $s2
	syscall
	li $v0, 10
	syscall

	